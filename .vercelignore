# Explicitly exclude all env files from Vercel deployments.
# Prevents Vercel's secret scanner from flagging local .env* files
# that may be present in the working directory during `vercel` CLI deploys.
.env*
.env*.local
!.env.example

# Vercel metadata / build artifacts
.vercel
node_modules
.next
out
build
coverage
*.tsbuildinfo

# OS / editor
.DS_Store
*.pem

# local caches
.cache
.hermes-cache

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
