{
  "name": "budgetbitch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node ./scripts/run-with-sanitized-env.mjs next dev",
    "build": "node ./scripts/run-with-sanitized-env.mjs next build",
    "prebuild": "node ./scripts/check-convex-deployment.mjs",
    "start": "node ./scripts/run-with-sanitized-env.mjs next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:idb": "node scripts/check-idb-stores.mjs",
    "check:csp": "node scripts/check-csp-hosts.mjs",
    "check:comments": "node scripts/check-stale-bug-comments.mjs",
    "check:bundle": "node scripts/check-bundle-budgets.mjs",
    "check:convex": "node scripts/check-convex-deployment.mjs",
    "check:convex-imports": "node scripts/check-convex-imports.mjs",
    "test": "vitest run",
    "test:convex": "vitest run --config convex/vitest.config.ts",
    "postinstall": "node scripts/copy-tesseract-assets.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/ensure-e2e-port.mjs && playwright test",
    "ci": "node scripts/run-full-ci.mjs",
    "cap:init": "capacitor init",
    "cap:add:android": "capacitor add android",
    "cap:add:ios": "capacitor add ios",
    "cap:sync": "capacitor sync",
    "cap:sync:all": "capacitor sync android ios",
    "cap:copy": "capacitor copy",
    "cap:run:android": "capacitor run android",
    "cap:run:ios": "capacitor run ios"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@convex-dev/auth": "^0.0.94",
    "@parcel/watcher": "^2.6.0",
    "@rive-app/canvas": "^2.39.1",
    "@swc/core": "^1.15.46",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^2.0.1",
    "agent-browser": "^0.33.1",
    "convex": "^1.34.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.4.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "18.2.0",
    "react-is": "^18.3.1",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "unrs-resolver": "^1.12.2",
    "web-push": "^3.6.7",
    "web-vitals": "^6.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.2",
    "convex-test": "^0.0.54",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jest-axe": "^9.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.27.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "es5-ext@0.10.64": true,
    "core-js-pure@3.49.0": true,
    "@swc/core@1.15.47": true,
    "tesseract.js@6.0.1": true,
    "agent-browser@0.33.1": true
  },
  "overrides": {
    "postcss": "^8.5.18"
  }
}
