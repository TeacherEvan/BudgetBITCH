# Budget-BOSS environment variables (frontend / build-time)
# Copy to .env.local and fill in. Never commit real secrets.

# Convex deployment URLs & config (auto-set by `npx convex dev` / Vercel integration)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
BUDGETBITCH_PROD_CONVEX_SLUG=steady-ox-280

# Web Push VAPID keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# App URL & Sentry error reporting
NEXT_PUBLIC_APP_URL=http://localhost:3000
SENTRY_DSN=
