# =============================================================================
# BudgetBITCH — Production & Development Environment Variable Specification
# =============================================================================
# Copy this file to `.env.local` for local development.
# For Vercel deployment, configure these under Project Settings > Environment Variables.
# For Convex deployment, configure backend variables in Convex Dashboard > Settings > Environment Variables.

# -----------------------------------------------------------------------------
# 1. FRONTEND / NEXT.JS (Vercel & .env.local)
# -----------------------------------------------------------------------------

# Primary Convex deployment URL (production e.g. https://steady-ox-280.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Convex HTTP actions site URL
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Canonical Application URL
SITE_URL=https://budget-bitch-green.vercel.app
NEXT_PUBLIC_APP_URL=https://budget-bitch-green.vercel.app

# Web Push VAPID Public Key (Generate using: npx tsx scripts/rotate-vapid.ts)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Convex Deploy Key (Required for CI/CD builds or `npx convex deploy`)
CONVEX_DEPLOY_KEY=

# Expected production Convex deployment slug (used by build verification script)
BUDGETBITCH_PROD_CONVEX_SLUG=steady-ox-280

# Convex deployment name for CLI / codegen (`npx convex dev` writes this)
CONVEX_DEPLOYMENT=

# -----------------------------------------------------------------------------
# 2. BACKEND / CONVEX DASHBOARD (Settings > Environment Variables)
# -----------------------------------------------------------------------------

# Web Push Keys (Matching NEXT_PUBLIC_VAPID_PUBLIC_KEY)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Convex Site & App Origin
CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Transactional Email (Resend)
RESEND_API_KEY=
AUTH_EMAIL_FROM="Budget Boss <onboarding@resend.dev>"

# Feedback & Admin Notifications
FEEDBACK_ADMIN_EMAIL=admin@budgetbitch.app

# AI / Receipt Scanning (Google Gemini API)
GEMINI_API_KEY=
