# dependencies
/node_modules

# next.js
/.next
/out

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# test output
/playwright-report
/.playwright-cli/
/test-results
/coverage
/dogfood-output
.worktrees/
.env*.local
.vscode/launch.json
.vscode/c_cpp_properties.json
.idea/

# agent cache
.cache/

# docs (local planning working set — kept on disk, not committed)
/docs/plans/
/docs/ideas/

# local DB (dev only)
*.idb
local-db-*

# backup files
*.bak
*.test.ts
# except the Convex function test suite (must be committed)
!budgetbitch/convex/**/*.test.ts
!convex/**/*.test.ts
# src unit tests are also committed (consistent with tracked src/**/*.test.ts(x))
!src/**/*.test.ts
!src/**/*.test.tsx
# agent skills (auto-installed, regenerable via `npx convex ai-files install`)
.claude/skills/convex-*
.claude/skills/convex/

.hermes-cache/
hermes_cache.py
__pycache__/

# clerk configuration (can include secrets)
/.clerk/

# Capacitor native projects (generated by `capacitor add`)
/android/
/ios/

# Code-review skill artifacts (advisory, not project source)
audit_report.md
review_findings.md
fix_summary.md
investigation_report.md
# Capacitor keeps its own .gitignore inside android/ios; ignore their build output
android/app/build/
android/.gradle/
ios/App/build/
ios/App/Pods/
.DS_Store

